    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>@NAME@</namespace>
      <joint_name>t200_w1_joint</joint_name>
      <topic>thrusters/w1/thrust</topic>
      <name>w1</name>
      <fluid_density>997</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>0.00977479</thrust_coefficient>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>51.4864</max_thrust_cmd>
      <min_thrust_cmd>-40.2071</min_thrust_cmd>
    </plugin>
