      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>523.6</maxRotVelocity>
      <motorConstant>7.2076e-05</motorConstant><momentConstant>0.0140005</momentConstant>
