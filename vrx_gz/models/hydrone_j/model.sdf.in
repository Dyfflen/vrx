    <plugin filename="libPolyhedraBuoyancyDrag.so" name="vrx::PolyhedraBuoyancyDrag">
      <fluid_density>997</fluid_density><fluid_level>0.0</fluid_level>
      <linear_drag>1.0461</linear_drag><angular_drag>0.212861</angular_drag>
      <buoyancy name="hull"><link_name>base_link</link_name><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.105006</radius><length>0.3</length></cylinder></geometry>
      </buoyancy>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
